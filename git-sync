#!/bin/sh
# git-sync: keep git repos fresh on macOS via launchd.
set -u

# ---- constants ----
GS_HOME=${GIT_SYNC_HOME:-$HOME/.git-sync}
GS_CONFIG="$GS_HOME/config"
GS_STATUS_DIR="$GS_HOME/status"
GS_STATE="$GS_HOME/state"
GS_LOG="$GS_HOME/git-sync.log"
GS_LAUNCHD_LOG="$GS_HOME/launchd.log"
GS_LOCK="$GS_HOME/lock"
GS_AGENTS_DIR=${GIT_SYNC_AGENTS_DIR:-$HOME/Library/LaunchAgents}
GS_LABEL=com.git-sync.agent
GS_PLIST="$GS_AGENTS_DIR/$GS_LABEL.plist"
GS_LAUNCHCTL=${GIT_SYNC_LAUNCHCTL:-launchctl}
GS_ROUTE=${GIT_SYNC_ROUTE:-route}
# Caller's original GIT_SSH_COMMAND (set-ness and value), restored per repo by git_env_for.
GS_ORIG_SSH_SET=${GIT_SSH_COMMAND+set}
GS_ORIG_SSH_CMD=${GIT_SSH_COMMAND-}
GS_JOB=0

# ---- util ----
die() { echo "git-sync: $*" >&2; exit 1; }
usage_die() {
  echo "git-sync: $*" >&2
  echo "Run 'git-sync help' for usage." >&2
  exit 2
}
warn() { echo "git-sync: warning: $*" >&2; }
now() { date +%Y-%m-%dT%H:%M:%S%z; }
require_init() {
  [ -f "$GS_CONFIG" ] || die "not initialized; run 'git-sync init'"
}

# ---- config ----
cfg_known() {
  case "$1" in
    sync.period|sync.repo|sync.root|sync.exclude|sync.mode|sync.branches|sync.ffCheckedOut|sync.fetchTimeout|sync.jobs|sync.jitter|sync.disableOfflineCheck|log.maxSize|notify.enabled|notify.events) return 0 ;;
  esac
  return 1
}

cfg_default() {
  case "$1" in
    sync.period) echo 20m ;;
    sync.mode) echo fast-forward ;;
    sync.branches) echo "" ;;
    sync.ffCheckedOut) echo false ;;
    sync.fetchTimeout) echo 5m ;;
    sync.jobs) echo 8 ;;
    sync.jitter) echo 5s ;;
    sync.disableOfflineCheck) echo false ;;
    log.maxSize) echo 3M ;;
    notify.enabled) echo false ;;
    notify.events) echo blocked ;;
    *) return 1 ;;
  esac
}

cfg_repo_name() {
  case "$1" in
    sync.mode) echo git-sync.mode ;;
    sync.branches) echo git-sync.branches ;;
    sync.ffCheckedOut) echo git-sync.ffCheckedOut ;;
    sync.fetchTimeout) echo git-sync.fetchTimeout ;;
    *) return 1 ;;
  esac
}

cfg_global_get() {
  git config -f "$GS_CONFIG" --get "$1" 2>/dev/null
}

cfg_get() {
  local key=$1 repo=${2:-} name val
  if [ -n "$repo" ] && name=$(cfg_repo_name "$key"); then
    if val=$(git -C "$repo" config --get "$name" 2>/dev/null); then
      printf '%s\n' "$val"
      return 0
    fi
  fi
  if val=$(cfg_global_get "$key"); then
    printf '%s\n' "$val"
    return 0
  fi
  cfg_default "$key"
}

cfg_source() {
  local key=$1 repo=${2:-} name
  if [ -n "$repo" ] && name=$(cfg_repo_name "$key") &&
     git -C "$repo" config --get "$name" >/dev/null 2>&1; then
    echo repo
  elif cfg_global_get "$key" >/dev/null; then
    echo global
  else
    echo default
  fi
}

parse_period() {
  local v=$1 n
  case "$v" in
    *s) echo "${v%s}" ;;
    *m) n=${v%m}; echo $((n * 60)) ;;
    *h) n=${v%h}; echo $((n * 3600)) ;;
    *) echo "$v" ;;
  esac
}

parse_size() {
  local v=$1 n
  case "$v" in
    *K) n=${v%K}; echo $((n * 1024)) ;;
    *M) n=${v%M}; echo $((n * 1048576)) ;;
    *G) n=${v%G}; echo $((n * 1073741824)) ;;
    *) echo "$v" ;;
  esac
}

validate_value() {
  local key=$1 v=$2 w
  case "$v" in
    *"
"*) echo "git-sync: value must be a single line" >&2; return 1 ;;
  esac
  case "$key" in
    sync.period)
      if ! printf '%s' "$v" | grep -Eq '^[1-9][0-9]*[smh]?$'; then
        echo "git-sync: sync.period must look like 20m, 90, 2h or 45s" >&2; return 1
      fi
      if [ "$(parse_period "$v")" -lt 60 ]; then
        echo "git-sync: sync.period must be >= 60s" >&2; return 1
      fi ;;
    sync.fetchTimeout)
      if ! printf '%s' "$v" | grep -Eq '^[1-9][0-9]*[smh]?$'; then
        echo "git-sync: sync.fetchTimeout must look like 5m, 90, 1h or 45s" >&2; return 1
      fi
      w=$(parse_period "$v")
      # GIT_SYNC_FETCH_TIMEOUT_MIN: test hook lowering the minimum
      if [ "$w" -lt "${GIT_SYNC_FETCH_TIMEOUT_MIN:-30}" ] || [ "$w" -gt 3600 ]; then
        echo "git-sync: sync.fetchTimeout must be from ${GIT_SYNC_FETCH_TIMEOUT_MIN:-30}s to 3600s" >&2; return 1
      fi ;;
    sync.mode)
      case "$v" in
        maintain-only|maintain-and-fetch|fast-forward) ;;
        *) echo "git-sync: sync.mode must be one of: maintain-only, maintain-and-fetch, fast-forward" >&2; return 1 ;;
      esac ;;
    sync.branches)
      if [ -z "$v" ]; then
        echo "git-sync: sync.branches must not be empty (unset it instead)" >&2; return 1
      fi
      set -f
      for w in $v; do
        if ! git check-ref-format --branch "$w" >/dev/null 2>&1; then
          echo "git-sync: invalid branch name: $w" >&2; set +f; return 1
        fi
      done
      set +f ;;
    sync.ffCheckedOut|sync.disableOfflineCheck|notify.enabled)
      case "$v" in
        true|false) ;;
        *) echo "git-sync: $key must be true or false" >&2; return 1 ;;
      esac ;;
    sync.jobs)
      if ! printf '%s' "$v" | grep -Eq '^[1-9][0-9]?$' || [ "$v" -gt 64 ]; then
        echo "git-sync: sync.jobs must be a number from 1 to 64" >&2; return 1
      fi ;;
    sync.jitter)
      if ! printf '%s' "$v" | grep -Eq '^[0-9]+s?$' || [ "${v%s}" -gt 60 ]; then
        echo "git-sync: sync.jitter must be 0-60 seconds, e.g. 5s or 0" >&2; return 1
      fi ;;
    log.maxSize)
      if ! printf '%s' "$v" | grep -Eq '^[1-9][0-9]*[KMG]?$'; then
        echo "git-sync: log.maxSize must look like 3M, 512K, 1G or a byte count" >&2; return 1
      fi ;;
    notify.events)
      if [ -z "$v" ]; then
        echo "git-sync: notify.events must not be empty" >&2; return 1
      fi
      set -f
      for w in $v; do
        case "$w" in
          finished|blocked) ;;
          *) echo "git-sync: invalid notify event: $w (allowed: finished blocked)" >&2; set +f; return 1 ;;
        esac
      done
      set +f ;;
  esac
  return 0
}

in_repo_root() {
  resolve_repo .
}

# ---- repos ----
# Prints the canonical main-worktree path of the repo containing PATH; rc 1 if none.
resolve_repo() {
  (
    cd "$1" 2>/dev/null || exit 1
    common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 1
    case "$common" in
      */.git) top=$(dirname "$common") ;;
      *) top=$common ;;
    esac
    cd -P "$top" 2>/dev/null && pwd
  )
}

is_linked_worktree() {
  local gd cd_
  gd=$(git -C "$1" rev-parse --path-format=absolute --git-dir 2>/dev/null) || return 1
  cd_=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [ "$gd" != "$cd_" ]
}

list_repos() {
  git config -f "$GS_CONFIG" --get-all sync.repo 2>/dev/null
}

repo_listed() {
  list_repos | grep -Fxq -- "$1"
}

list_roots() {
  git config -f "$GS_CONFIG" --get-all sync.root 2>/dev/null
}

root_watched() {
  list_roots | grep -Fxq -- "$1"
}

list_excludes() {
  git config -f "$GS_CONFIG" --get-all sync.exclude 2>/dev/null
}

repo_excluded() {
  list_excludes | grep -Fxq -- "$1"
}

# ---- log/lock/status ----
status_file() {
  local id
  id=$(printf %s "$1" | shasum -a 1 | cut -c1-16)
  printf '%s/%s\n' "$GS_STATUS_DIR" "$id"
}

status_field() {
  git config -f "$(status_file "$1")" "status.$2" 2>/dev/null
}

# Appends a log line; never fails the caller.
log_msg() {
  mkdir -p "$GS_HOME" 2>/dev/null
  printf '%s %s %s\n' "$(now)" "$1" "$2" >> "$GS_LOG" 2>/dev/null
  return 0
}

log_rotate() {
  local size max
  [ -f "$GS_LOG" ] || return 0
  size=$(wc -c < "$GS_LOG" | tr -d ' ')
  max=$(parse_size "$(cfg_get log.maxSize)")
  if [ "$size" -gt "$max" ]; then
    mv -f "$GS_LOG" "$GS_LOG.1"
  fi
  return 0
}

# Offline check: online iff a default route exists. Local routing table only (-n: no DNS).
is_online() {
  $GS_ROUTE -n get default >/dev/null 2>&1
}

# Offline streak (global state file, git-config format): since = first skip, lastSkip = latest.
streak_record() {
  local t; t=$(now)
  streak_read since >/dev/null || git config -f "$GS_STATE" offline.since "$t"
  git config -f "$GS_STATE" offline.lastSkip "$t"
}
# streak_read since|lastSkip: prints the field; rc 1 if no streak.
streak_read() {
  git config -f "$GS_STATE" "offline.$1" 2>/dev/null
}
streak_clear() {
  [ ! -f "$GS_STATE" ] || git config -f "$GS_STATE" --remove-section offline 2>/dev/null
  return 0
}

is_repo() { git -C "$1" rev-parse --git-dir >/dev/null 2>&1; }
# mode_fetches MODE: rc 0 if MODE fetches remotes (needs network).
mode_fetches() {
  case "$1" in maintain-and-fetch|fast-forward) return 0 ;; esac
  return 1
}

# needs_offline_check ENTRIES: rc 0 unless every repo (one per line) is a valid repo
# whose effective mode does not fetch; those runs need no network.
needs_offline_check() {
  local repo
  while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    is_repo "$repo" || return 0
    ! mode_fetches "$(cfg_get sync.mode "$repo")" || return 0
  done <<EOF
$1
EOF
  return 1
}

lock_release() {
  if [ "$(cat "$GS_LOCK/pid" 2>/dev/null)" = "$$" ]; then
    rm -rf "$GS_LOCK"
  fi
  return 0
}

lock_acquire() {
  local pid
  if ! mkdir "$GS_LOCK" 2>/dev/null; then
    pid=$(cat "$GS_LOCK/pid" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      case "$(ps -p "$pid" -o command= 2>/dev/null)" in
        *git-sync*) return 1 ;;
      esac
    fi
    rm -rf "$GS_LOCK"
    mkdir "$GS_LOCK" 2>/dev/null || return 1
  fi
  echo "$$" > "$GS_LOCK/pid"
  trap 'lock_release' EXIT
  GS_SIG_HANDLER=run_interrupted
  trap 'on_signal' INT TERM
  return 0
}

# ---- signals ----
# INT/TERM run on_signal, which calls GS_SIG_HANDLER. Between sig_defer and
# sig_resume (while a background job starts and its id is recorded) a signal
# is only marked pending, then handled by sig_resume, so no job goes untracked.
GS_SIG_HANDLER=
GS_SIG_DEFER=
GS_SIG_PENDING=
on_signal() {
  if [ -n "$GS_SIG_DEFER" ]; then
    GS_SIG_PENDING=1
    return 0
  fi
  "$GS_SIG_HANDLER"
}
sig_defer() { GS_SIG_DEFER=1; }
sig_resume() {
  GS_SIG_DEFER=
  [ -z "$GS_SIG_PENDING" ] || "$GS_SIG_HANDLER"
}

# Poll interval (seconds) of wait_gone.
GS_POLL=0.2

# wait_gone SECS TARGET...: wait up to SECS seconds until no TARGET (a pid, or
# -pgid for a process group) is alive. Returns 1 if some still is.
wait_gone() {
  local end t alive
  end=$(( $(date +%s) + $1 )); shift
  while :; do
    alive=
    for t in "$@"; do kill -0 "$t" 2>/dev/null && alive=1; done
    [ -n "$alive" ] || return 0
    [ "$(date +%s)" -lt "$end" ] || return 1
    sleep "$GS_POLL"
  done
}

# group_term PGID: TERM a process group, then CONT it in case it is stopped.
group_term() {
  kill -TERM -"$1" 2>/dev/null
  kill -CONT -"$1" 2>/dev/null
}

# group_reap PGID GRACE: group_term, then KILL the group if it is still alive
# after GRACE seconds.
group_reap() {
  group_term "$1"
  wait_gone "$2" -"$1" || kill -KILL -"$1" 2>/dev/null
}

# PID of the xargs running parallel `sync --all` workers; empty otherwise.
GS_XARGS_PID=

# run_interrupted: INT/TERM handler of a run. Stops the inline fetch, then
# xargs (frozen first so it starts no new worker) and every worker it started.
# Each worker stops its own fetch within GS_ABORT_GRACE; stragglers are killed
# after that, and temp dirs of workers that died uncleanly are removed (the
# run holds the lock, so no other run owns them). Exiting releases the lock.
run_interrupted() {
  local workers
  fetch_abort
  if [ -n "$GS_XARGS_PID" ]; then
    kill -STOP "$GS_XARGS_PID" 2>/dev/null
    workers=$(pgrep -P "$GS_XARGS_PID")
    [ -z "$workers" ] || kill -TERM $workers 2>/dev/null
    kill -TERM "$GS_XARGS_PID" 2>/dev/null
    kill -CONT "$GS_XARGS_PID" 2>/dev/null
    if [ -n "$workers" ] && ! wait_gone $((GS_ABORT_GRACE + 1)) $workers; then
      kill -KILL $workers 2>/dev/null
    fi
    rm -rf "$GS_HOME"/fetch.*
  fi
  host_state_clear
  exit 1
}

# ---- sync engine ----
SYNC_BLOCKERS=
SYNC_NOTES=
SYNC_RESULT=
SYNC_FAILED_REMOTES=
SYNC_PREV_KEYS=
SYNC_REPO=

sync_reset() {
  SYNC_BLOCKERS=
  SYNC_NOTES=
  SYNC_RESULT=ok
  SYNC_FAILED_REMOTES=
  SYNC_PREV_KEYS=
}

# add_blocker KEY DETAIL
add_blocker() {
  local line="$1 ${2:-}"
  if [ -n "$SYNC_BLOCKERS" ]; then
    SYNC_BLOCKERS="$SYNC_BLOCKERS
$line"
  else
    SYNC_BLOCKERS=$line
  fi
  log_msg WARN "$SYNC_REPO: blocker $line"
}

add_note() {
  if [ -n "$SYNC_NOTES" ]; then
    SYNC_NOTES="$SYNC_NOTES
$1"
  else
    SYNC_NOTES=$1
  fi
}

blocker_keys() {
  [ -n "$SYNC_BLOCKERS" ] || return 0
  printf '%s\n' "$SYNC_BLOCKERS" | awk '{print $1}'
}

first_line() {
  printf '%s\n' "$1" | sed -n 1p
}

git_env_for() {
  GIT_TERMINAL_PROMPT=0
  GIT_OPTIONAL_LOCKS=0
  export GIT_TERMINAL_PROMPT GIT_OPTIONAL_LOCKS
  if [ -n "$GS_ORIG_SSH_SET" ]; then
    GIT_SSH_COMMAND=$GS_ORIG_SSH_CMD
    export GIT_SSH_COMMAND
  elif git -C "$1" config --get core.sshCommand >/dev/null 2>&1; then
    unset GIT_SSH_COMMAND
  else
    GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=30 -o ServerAliveInterval=15 -o ServerAliveCountMax=3"
    export GIT_SSH_COMMAND
  fi
}

# Active fetch (process group id) and its sleeper (pgid); empty when none runs.
GS_FETCH_PGID=
GS_SLEEPER_PGID=
# Seconds a fetch gets to exit after TERM before KILL: on timeout, on interrupt.
GS_FETCH_GRACE=5
GS_ABORT_GRACE=2

# fetch_bounded REPO REMOTE SECS TMPDIR: one `git fetch`, cut off after SECS.
# The fetch and the sleeper each run in their own process group (job control
# is on only while starting them), so signals reach every descendant (ssh,
# credential helpers, proxies). On timeout the sleeper touches TMPDIR/timeout
# and reaps the fetch's group (group_reap, GS_FETCH_GRACE); it does nothing if
# this process is gone by then, as the pgid may have been reused. Returns
# git's exit status; stderr goes to TMPDIR/err. `wait` stderr is discarded to
# hide job-control notices.
fetch_bounded() {
  local repo=$1 r=$2 secs=$3 d=$4 rc
  rm -f "$d/timeout"
  sig_defer
  set -m
  LC_ALL=C git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 -C "$repo" fetch --prune --quiet "$r" >/dev/null 2>"$d/err" &
  GS_FETCH_PGID=$!
  (
    sleep "$secs"
    kill -0 "$$" 2>/dev/null || exit 0
    : > "$d/timeout"
    group_reap "$GS_FETCH_PGID" "$GS_FETCH_GRACE"
    exit 0
  ) </dev/null >/dev/null 2>&1 &
  GS_SLEEPER_PGID=$!
  set +m
  sig_resume
  wait "$GS_FETCH_PGID" 2>/dev/null
  rc=$?
  # Sleeper fired: let it finish the grace/KILL sequence. Otherwise stop it.
  [ -e "$d/timeout" ] || kill -TERM -"$GS_SLEEPER_PGID" 2>/dev/null
  wait "$GS_SLEEPER_PGID" 2>/dev/null
  GS_FETCH_PGID=
  GS_SLEEPER_PGID=
  return "$rc"
}

# fetch_abort: on interrupt, stop the active fetch's sleeper, reap the fetch's
# group (group_reap, GS_ABORT_GRACE; also when the timeout already fired), and
# remove this process's fetch temp dir.
fetch_abort() {
  [ -z "$GS_SLEEPER_PGID" ] || kill -TERM -"$GS_SLEEPER_PGID" 2>/dev/null
  [ -z "$GS_FETCH_PGID" ] || group_reap "$GS_FETCH_PGID" "$GS_ABORT_GRACE"
  rm -rf "$GS_HOME/fetch.$$"
}

# Unreachable hosts. Per-run shared state: one marker dir $GS_HOME/host.<sha1(host) first 16 hex>
# per unreachable host, holding `name` (the host) and `skips` (one
# "<repo>\t<remote>" line per host skip). The lock-owning run removes them at
# run start (leftovers of a killed run), at run end and on interrupt.

# remote_host REPO REMOTE: prints the host of REMOTE's URL; rc 1 if it has none
# (never grouped). Parses ssh:// and scp-style [user@]host:path URLs.
remote_host() {
  local url h
  url=$(git -C "$1" ls-remote --get-url "$2" 2>/dev/null) || return 1
  case "$url" in
    ssh://*) h=${url#ssh://}; h=${h%%/*}; h=${h##*@} ;;
    *::*|*://*|/*|./*|../*) return 1 ;;
    *:*)
      h=${url%%:*}
      case "$h" in */*) return 1 ;; esac
      h=${h##*@} ;;
    *) return 1 ;;
  esac
  [ -n "$h" ] || return 1
  printf '%s\n' "$h"
}

host_marker() {
  printf '%s/host.%s\n' "$GS_HOME" "$(printf %s "$1" | shasum -a 1 | cut -c1-16)"
}

host_unreachable() { [ -d "$(host_marker "$1")" ]; }

# host_mark_unreachable HOST: creates HOST's marker atomically; rc 1 if it existed.
host_mark_unreachable() {
  local m; m=$(host_marker "$1")
  mkdir "$m" 2>/dev/null || return 1
  printf '%s\n' "$1" > "$m/name"
}

# host_skip HOST REMOTE: record a host skip of REMOTE in the current repo.
host_skip() {
  add_note "$2: skipped (host $1 unreachable)"
  printf '%s\t%s\n' "$SYNC_REPO" "$2" >> "$(host_marker "$1")/skips"
  log_msg INFO "$SYNC_REPO: $2 skipped (host $1 unreachable)"
}

# is_connection_error FILE: rc 0 if fetch stderr FILE (C locale) shows a connection-class failure.
is_connection_error() {
  grep -qiE 'could not resolve host|connection refused|connection timed out|operation timed out|network is unreachable|no route to host|failed to connect' "$1" 2>/dev/null
}

host_state_clear() { rm -rf "$GS_HOME"/host.*; }

# host_report: "<host>\t<skips>" per unreachable host with at least one host skip,
# sorted by host. Read by the parent before host_state_clear.
host_report() {
  local m
  for m in "$GS_HOME"/host.*; do
    [ -s "$m/skips" ] || continue
    printf '%s\t%s\n' "$(cat "$m/name")" "$(grep -c . "$m/skips")"
  done | sort
}

sync_fetch() {
  local repo=$1 remotes r err limit secs d host
  remotes=$(git -C "$repo" remote 2>/dev/null)
  [ -n "$remotes" ] || return 0
  limit=$(cfg_get sync.fetchTimeout "$repo")
  secs=$(parse_period "$limit")
  d="$GS_HOME/fetch.$$"
  mkdir -p "$d"
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    host=$(remote_host "$repo" "$r") || host=
    if [ -n "$host" ] && host_unreachable "$host"; then
      host_skip "$host" "$r"
    else
      if fetch_bounded "$repo" "$r" "$secs" "$d"; then
        [ -e "$d/timeout" ] || continue
      fi
      if [ -e "$d/timeout" ]; then
        add_blocker "fetch-timeout:$r" "timed out after $limit"
      else
        err=$(cat "$d/err" 2>/dev/null)
        add_blocker "fetch-failed:$r" "$(first_line "$err")"
        if [ -n "$host" ] && is_connection_error "$d/err"; then
          host_mark_unreachable "$host"
        fi
      fi
    fi
    SYNC_FAILED_REMOTES="${SYNC_FAILED_REMOTES:+$SYNC_FAILED_REMOTES }$r"
  done <<EOF
$remotes
EOF
  rm -rf "$d"
  return 0
}

# ff_branch_list REPO: branches to fast-forward, one per line.
ff_branch_list() {
  local repo=$1 cfg b head
  cfg=$(cfg_get sync.branches "$repo")
  if [ -n "$cfg" ]; then
    set -f
    for b in $cfg; do printf '%s\n' "$b"; done
    set +f
    return 0
  fi
  head=$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)
  if [ -z "$head" ] && git -C "$repo" remote 2>/dev/null | grep -qx origin; then
    case " $SYNC_FAILED_REMOTES " in
      *" origin "*) ;;
      *)
        git -C "$repo" remote set-head origin --auto >/dev/null 2>&1
        head=$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)
        ;;
    esac
  fi
  if [ -n "$head" ]; then
    printf '%s\n' "${head#origin/}"
    return 0
  fi
  for b in develop main master; do
    if git -C "$repo" show-ref --verify -q "refs/heads/$b"; then
      printf '%s\n' "$b"
      return 0
    fi
  done
  return 0
}

# worktree_of REPO BRANCH: path of the worktree that has BRANCH checked out; rc 1 if none.
worktree_of() {
  local out
  out=$(git -C "$1" worktree list --porcelain 2>/dev/null | awk -v ref="refs/heads/$2" '
    /^worktree / { p = substr($0, 10) }
    $0 == "branch " ref { print p; exit }')
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

# ff_inprogress WORKTREE: prints the name of the first in-progress operation marker.
ff_inprogress() {
  local w=$1 n p
  for n in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG rebase-merge rebase-apply; do
    p=$(git -C "$w" rev-parse --git-path "$n" 2>/dev/null) || continue
    case "$p" in /*) ;; *) p="$w/$p" ;; esac
    if [ -e "$p" ]; then
      printf '%s\n' "$n"
      return 0
    fi
  done
  return 1
}

# ff_being_rebased REPO BRANCH: rc 0 if any worktree is rebasing/bisecting BRANCH.
ff_being_rebased() {
  local repo=$1 b=$2 w f p v wts
  wts=$(git -C "$repo" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
  while IFS= read -r w; do
    [ -n "$w" ] || continue
    for f in rebase-merge/head-name rebase-apply/head-name BISECT_START; do
      p=$(git -C "$w" rev-parse --git-path "$f" 2>/dev/null) || continue
      case "$p" in /*) ;; *) p="$w/$p" ;; esac
      [ -f "$p" ] || continue
      v=$(sed -n 1p "$p" 2>/dev/null)
      if [ "$v" = "refs/heads/$b" ] || { [ "$f" = BISECT_START ] && [ "$v" = "$b" ]; }; then
        return 0
      fi
    done
  done <<EOF
$wts
EOF
  return 1
}

# sync_ff REPO: fast-forward configured/default branches (spec "Sync algorithm" step 2).
sync_ff() {
  local repo=$1 b u remote old new w err name n ffco branches ahead behind
  ffco=$(cfg_get sync.ffCheckedOut "$repo")
  branches=$(ff_branch_list "$repo")
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    git -C "$repo" show-ref --verify -q "refs/heads/$b" || continue
    u=$(git -C "$repo" rev-parse -q --verify --symbolic-full-name "$b@{upstream}" 2>/dev/null)
    [ -n "$u" ] || continue
    remote=$(git -C "$repo" config "branch.$b.remote" 2>/dev/null)
    case " $SYNC_FAILED_REMOTES " in *" $remote "*) continue ;; esac
    old=$(git -C "$repo" rev-parse "refs/heads/$b" 2>/dev/null) || continue
    new=$(git -C "$repo" rev-parse "$u" 2>/dev/null) || continue
    [ "$old" != "$new" ] || continue
    ahead=$(git -C "$repo" rev-list --count "$new..$old" 2>/dev/null) || continue
    behind=$(git -C "$repo" rev-list --count "$old..$new" 2>/dev/null) || continue
    if [ "$behind" = 0 ]; then
      [ "$ahead" = 0 ] || add_note "$b: ahead $ahead (not pushed)"
      continue
    fi
    if [ "$ahead" != 0 ]; then
      add_blocker "$b:diverged" "ahead $ahead, behind $behind"
      continue
    fi
    if w=$(worktree_of "$repo" "$b"); then
      if [ "$ffco" != true ]; then
        add_note "$b: skipped (checked out)"
        continue
      fi
      if name=$(ff_inprogress "$w"); then
        add_blocker "$b:in-progress" "$name in $w"
        continue
      fi
      n=$(git -C "$w" status --porcelain --untracked-files=no | wc -l | tr -d ' ')
      if [ "$n" != 0 ]; then
        add_blocker "$b:dirty" "$n tracked files changed in $w"
        continue
      fi
      if [ "$(git -C "$w" symbolic-ref -q HEAD 2>/dev/null)" != "refs/heads/$b" ]; then
        add_blocker "$b:ff-failed" "worktree $w switched branch"
        continue
      fi
      if ! err=$(git -C "$w" merge --ff-only --no-autostash --quiet "$new" 2>&1); then
        add_blocker "$b:ff-failed" "$(first_line "$err")"
        continue
      fi
    else
      if ff_being_rebased "$repo" "$b"; then
        add_blocker "$b:ff-failed" "branch is being rebased/bisected"
        continue
      fi
      if ! err=$(git -C "$repo" fetch --quiet . "$u:refs/heads/$b" 2>&1); then
        add_blocker "$b:ff-failed" "$(first_line "$err")"
        continue
      fi
    fi
    log_msg INFO "$repo $b: $(printf %s "$old" | cut -c1-7)..$(printf %s "$new" | cut -c1-7)"
  done <<EOF
$branches
EOF
  return 0
}

sync_maintenance() {
  local err
  if ! err=$(git -C "$1" \
      -c maintenance.gc.enabled=false \
      -c maintenance.commit-graph.enabled=true \
      -c maintenance.loose-objects.enabled=true \
      -c maintenance.incremental-repack.enabled=true \
      -c maintenance.pack-refs.enabled=true \
      maintenance run --auto --quiet 2>&1 >/dev/null); then
    add_blocker maintenance:failed "$(first_line "$err")"
  fi
  return 0
}

# status_write REPO MODE: atomically rewrite the repo's status file from SYNC_* state.
status_write() {
  local repo=$1 mode=$2 sf tmp last line wi
  sf=$(status_file "$repo")
  wi=$(status_field "$repo" watchInstalled)
  tmp="$GS_STATUS_DIR/.tmp.$$"
  mkdir -p "$GS_STATUS_DIR" || return 1
  if [ "$SYNC_RESULT" = ok ]; then
    last=$(now)
  else
    last=$(status_field "$repo" lastSuccess)
  fi
  rm -f "$tmp"
  git config -f "$tmp" status.path "$repo"
  git config -f "$tmp" status.mode "$mode"
  git config -f "$tmp" status.lastRun "$(now)"
  [ -z "$last" ] || git config -f "$tmp" status.lastSuccess "$last"
  git config -f "$tmp" status.result "$SYNC_RESULT"
  [ -z "$wi" ] || git config -f "$tmp" status.watchInstalled "$wi"
  if [ -n "$SYNC_BLOCKERS" ]; then
    while IFS= read -r line; do
      git config -f "$tmp" --add status.blocker "$line"
    done <<EOF
$SYNC_BLOCKERS
EOF
  fi
  if [ -n "$SYNC_NOTES" ]; then
    while IFS= read -r line; do
      git config -f "$tmp" --add status.note "$line"
    done <<EOF
$SYNC_NOTES
EOF
  fi
  mv -f "$tmp" "$sf"
}

# sync_repo REPO LISTED
sync_repo() {
  local repo=$1 listed=$2 mode
  SYNC_REPO=$repo
  sync_reset
  if [ ! -d "$repo" ]; then
    SYNC_RESULT=missing
    log_msg WARN "$repo: missing"
    mode=$(cfg_get sync.mode)
  elif ! is_repo "$repo"; then
    SYNC_RESULT=error
    mode=$(cfg_get sync.mode)
    add_blocker repo:invalid "not a git repository"
  else
    mode=$(cfg_get sync.mode "$repo")
    git_env_for "$repo"
    if mode_fetches "$mode"; then
      sync_fetch "$repo"
    fi
    if [ "$mode" = fast-forward ]; then
      sync_ff "$repo"
    fi
    sync_maintenance "$repo"
    if [ -n "$SYNC_BLOCKERS" ]; then
      SYNC_RESULT=blocked
    fi
  fi
  if [ "$listed" = 1 ]; then
    SYNC_PREV_KEYS=$(prev_blocker_keys "$(status_file "$repo")")
    status_write "$repo" "$mode"
  fi
  log_msg INFO "$repo: $SYNC_RESULT"
  return 0
}

# sync_one_report REPO LISTED RUNFILE: sync one repo, print its summary line
# (manual runs only) and append "<result>\t<new blocker keys>\t<repo>" to
# RUNFILE as one write, so parallel workers never interleave within a line.
# Blocker keys never contain tabs, so the tab separator is safe.
sync_one_report() {
  local repo=$1 keys new
  SYNC_PREV_KEYS=
  sync_repo "$repo" "$2" </dev/null
  if [ "$GS_JOB" = 0 ]; then
    keys=$(blocker_keys | paste -sd, -)
    if [ -n "$keys" ]; then
      printf '%s: %s (%s)\n' "$repo" "$SYNC_RESULT" "$keys"
    else
      printf '%s: %s\n' "$repo" "$SYNC_RESULT"
    fi
  fi
  new=$(new_blocker_keys)
  # "-" stands for "no new keys": tab is IFS whitespace, so an empty middle
  # field would be swallowed by `read`.
  printf '%s\t%s\t%s\n' "$SYNC_RESULT" "${new:--}" "$repo" >> "$3"
}

# jitter_sleep: wait a random 0..sync.jitter seconds (fractional).
jitter_sleep() {
  local max
  max=$(cfg_get sync.jitter)
  max=${max%s}
  [ "$max" -gt 0 ] 2>/dev/null || return 0
  # In the background so that `wait` lets TERM be handled at once.
  sig_defer
  sleep "$(awk -v m="$max" -v s="$$" 'BEGIN { srand(s); printf "%.2f", rand() * m }')" &
  GS_JITTER_PID=$!
  sig_resume
  wait "$GS_JITTER_PID"
  GS_JITTER_PID=
}

# PID of a worker's jitter sleep while it runs; empty otherwise.
GS_JITTER_PID=

# worker_interrupted: TERM handler of a worker.
worker_interrupted() {
  [ -z "$GS_JITTER_PID" ] || kill "$GS_JITTER_PID" 2>/dev/null
  fetch_abort
  exit 1
}

# cmd___sync_one JOB RUNFILE REPO: xargs worker for parallel `sync --all`.
# Only TERM is trapped: workers inherit an ignored INT (xargs runs as an
# asynchronous list without job control), which a shell cannot trap.
cmd___sync_one() {
  GS_JOB=$1
  GS_SIG_HANDLER=worker_interrupted
  trap 'on_signal' TERM
  jitter_sleep
  sync_one_report "$3" 1 "$2"
}

# ---- agent ----
self_path() {
  local d
  d=$(cd -P "$(dirname "$0")" && pwd) || return 1
  echo "$d/$(basename "$0")"
}

xml_escape() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
}

agent_write_plist() {
  local self secs
  self=$(self_path) || die "cannot resolve own path"
  secs=$(parse_period "$(cfg_get sync.period)")
  mkdir -p "$GS_AGENTS_DIR" || die "cannot create $GS_AGENTS_DIR"
  {
    printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
    printf '%s\n' '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
    printf '%s\n' '<plist version="1.0">' '<dict>'
    printf '  <key>Label</key>\n  <string>%s</string>\n' "$(xml_escape "$GS_LABEL")"
    printf '  <key>ProgramArguments</key>\n  <array>\n'
    printf '    <string>%s</string>\n' "$(xml_escape "$self")" sync --all --job
    printf '  </array>\n'
    printf '  <key>StartInterval</key>\n  <integer>%s</integer>\n' "$secs"
    printf '  <key>RunAtLoad</key>\n  <true/>\n'
    printf '  <key>EnvironmentVariables</key>\n  <dict>\n'
    printf '    <key>PATH</key>\n    <string>%s</string>\n' "$(xml_escape "${PATH-}")"
    printf '    <key>GIT_SYNC_HOME</key>\n    <string>%s</string>\n' "$(xml_escape "$GS_HOME")"
    printf '  </dict>\n'
    printf '  <key>StandardOutPath</key>\n  <string>%s</string>\n' "$(xml_escape "$GS_LAUNCHD_LOG")"
    printf '  <key>StandardErrorPath</key>\n  <string>%s</string>\n' "$(xml_escape "$GS_LAUNCHD_LOG")"
    printf '%s\n' '</dict>' '</plist>'
  } > "$GS_PLIST" || die "cannot write $GS_PLIST"
}

agent_loaded() {
  $GS_LAUNCHCTL print "gui/$(id -u)/$GS_LABEL" >/dev/null 2>&1
}

agent_reload_if_installed() {
  if [ -f "$GS_PLIST" ]; then cmd_start >/dev/null; fi
}

# ---- notifications ----
notify() {
  if [ -n "${GIT_SYNC_NOTIFY_CMD:-}" ]; then
    "$GIT_SYNC_NOTIFY_CMD" "$1" "$2" </dev/null >/dev/null 2>&1 ||
      log_msg WARN "notification failed"
  else
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' "$1" "$2" </dev/null >/dev/null 2>&1 ||
      log_msg WARN "notification failed"
  fi
  return 0
}

notify_wanted() {
  local w found=1
  [ "$GS_JOB" = 1 ] || return 1
  [ "$(cfg_get notify.enabled)" = true ] || return 1
  set -f
  for w in $(cfg_get notify.events); do
    if [ "$w" = "$1" ]; then found=0; fi
  done
  set +f
  return "$found"
}

# A run sends at most one notification, at the end: newly blocked repos (event
# `blocked`) and/or the run summary (event `finished`). notify_repo only
# collects; notify_run_end sends.
NOTIFY_NEW_BLOCKED=   # "; "-separated "<repo>: <key>, <key>"
NOTIFY_NEW_COUNT=0
NOTIFY_HOSTS=        # "; <host> unreachable (N skipped)" per reported host

# prev_blocker_keys STATUS_FILE: the blocker keys of a repo's previous run, one
# per line. A host skip of <remote> counts as fetch-failed:<remote>, so an outage
# whose blocker moves to another repo between runs is not "newly blocked".
prev_blocker_keys() {
  git config -f "$1" --get-all status.blocker 2>/dev/null | awk '{print $1}'
  git config -f "$1" --get-all status.note 2>/dev/null |
    sed -n 's/^\(.*\): skipped (host .* unreachable)$/fetch-failed:\1/p'
}

# new_blocker_keys: comma-separated blocker keys of the repo just synced that
# were not in its previous status file (SYNC_PREV_KEYS); empty if none.
new_blocker_keys() {
  local k new=
  for k in $(blocker_keys); do
    if ! printf '%s\n' "$SYNC_PREV_KEYS" | grep -qxF -- "$k"; then
      new=${new:+$new, }$k
    fi
  done
  printf '%s' "$new"
}

# notify_collect REPO NEW_KEYS: remember a newly blocked repo for notify_run_end.
notify_collect() {
  [ -n "$2" ] || return 0
  notify_wanted blocked || return 0
  NOTIFY_NEW_COUNT=$((NOTIFY_NEW_COUNT + 1))
  NOTIFY_NEW_BLOCKED=${NOTIFY_NEW_BLOCKED:+$NOTIFY_NEW_BLOCKED; }"$(basename "$1"): $2"
  NOTIFY_LAST_REPO=$(basename "$1") NOTIFY_LAST_KEYS=$2
  return 0
}

notify_run_end() {
  local title msg summary=
  if notify_wanted finished; then
    summary="$(( $1 + $2 + $3 )) repos: $1 ok, $2 blocked, $3 failed$NOTIFY_HOSTS"
  fi
  if [ "$NOTIFY_NEW_COUNT" -eq 1 ]; then
    title="git-sync: $NOTIFY_LAST_REPO" msg=$NOTIFY_LAST_KEYS
  elif [ "$NOTIFY_NEW_COUNT" -gt 1 ]; then
    title="git-sync: $NOTIFY_NEW_COUNT repos newly blocked" msg=$NOTIFY_NEW_BLOCKED
  elif [ -n "$summary" ]; then
    notify "git-sync" "$summary"
    return 0
  else
    return 0
  fi
  notify "$title" "$msg${summary:+ — $summary}"
}

# ---- commands ----
cmd_help() {
  cat <<'EOF'
Usage: git-sync <command> [args]

Commands:
  init                         Create ~/.git-sync with default config
  install [<path>]             Add a repo (default: current) to the sync list
  install -r <dir>             Add every repo directly inside <dir> (depth 1)
  install -r <dir> --watch     Same, and add new clones in <dir> at every sync --all
  uninstall [<path>]           Remove a repo from the sync list
  uninstall -r <dir> --watch   Stop watching <dir>; its repos stay installed
  list [--watch]               List synced repos, watched roots and exclusions
                               (--watch: only the watched roots, one per line)
  status [--verbose] [--list-order]
                               Show agent state and per-repo sync status
  start                        Install and load the launchd agent
  stop                         Unload and remove the launchd agent
  config [--global] [--force] [--unset] [<key> [<value>]]
                               Show or change configuration
  sync [<path> | --all]        Sync the current (or given) repo, or all listed repos
  notifications [enable|disable]
                               Show or toggle notifications
  help                         Show this help
EOF
}

cmd_init() {
  if [ -f "$GS_CONFIG" ]; then
    mkdir -p "$GS_STATUS_DIR" || die "cannot create $GS_STATUS_DIR"
    echo "git-sync: already initialized ($GS_HOME)"
    return 0
  fi
  mkdir -p "$GS_STATUS_DIR" || die "cannot create $GS_STATUS_DIR"
  git config -f "$GS_CONFIG" sync.period 20m &&
  git config -f "$GS_CONFIG" sync.mode fast-forward &&
  git config -f "$GS_CONFIG" sync.ffCheckedOut false &&
  git config -f "$GS_CONFIG" sync.jobs 8 &&
  git config -f "$GS_CONFIG" sync.jitter 5s &&
  git config -f "$GS_CONFIG" log.maxSize 3M &&
  git config -f "$GS_CONFIG" notify.enabled false &&
  git config -f "$GS_CONFIG" notify.events blocked ||
    die "cannot write $GS_CONFIG"
  echo "Initialized git-sync in $GS_HOME"
  echo "Next: run 'git-sync install' inside a repo, then 'git-sync start'."
}

cmd_install() {
  if [ "${1:-}" = "-r" ]; then
    shift
    install_root "$@"
    return
  fi
  local target=${1:-.} repo
  repo=$(resolve_repo "$target") || die "not a git repository: $target"
  if is_linked_worktree "$target"; then
    warn "linked worktree; registered main worktree $repo instead"
    log_msg WARN "install: $target is a linked worktree; registered $repo"
  fi
  if repo_listed "$repo"; then
    install_unexclude "$repo"
    echo "Already installed: $repo"
    return 0
  fi
  git config -f "$GS_CONFIG" --add sync.repo "$repo" || die "cannot write $GS_CONFIG"
  log_msg INFO "install: $repo"
  install_unexclude "$repo"
  if git -C "$repo" remote | grep -qx origin &&
     ! git -C "$repo" symbolic-ref -q refs/remotes/origin/HEAD >/dev/null; then
    GIT_TERMINAL_PROMPT=0 git -C "$repo" remote set-head origin --auto >/dev/null 2>&1 ||
      warn "could not determine origin/HEAD for $repo"
  fi
  echo "Installed: $repo"
}

# install_unexclude REPO: an explicit install undoes the repo's exclusion.
# Called only once REPO is in the sync list, so a failed write never loses it.
install_unexclude() {
  repo_excluded "$1" || return 0
  git config -f "$GS_CONFIG" --fixed-value --unset-all sync.exclude "$1" || die "cannot write $GS_CONFIG"
  log_msg INFO "install: $1 no longer excluded"
}

# parse_root_args USAGE ARG...: sets ROOT_DIR and ROOT_WATCH from "<dir> [--watch]"
# (--watch may come first).
parse_root_args() {
  local usage=$1
  shift
  ROOT_DIR= ROOT_WATCH=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --watch) ROOT_WATCH=1 ;;
      -*) usage_die "$usage" ;;
      *) [ -z "$ROOT_DIR" ] || usage_die "$usage"; ROOT_DIR=$1 ;;
    esac
    shift
  done
  [ -n "$ROOT_DIR" ] || usage_die "$usage"
}

# install_root <dir> [--watch]: install the children of <dir>; with --watch,
# also add <dir> to the watched roots.
install_root() {
  local dir rc=0
  parse_root_args "usage: git-sync install -r <dir> [--watch]" "$@"
  [ -d "$ROOT_DIR" ] || die "not a directory: $ROOT_DIR"
  if [ "$ROOT_WATCH" = 0 ]; then
    install_children "$ROOT_DIR"
    return
  fi
  dir=$(cd -P "$ROOT_DIR" && pwd) || die "cannot read $ROOT_DIR"
  if root_watched "$dir"; then
    echo "Already watched: $dir"
    return 0
  fi
  install_children "$dir" 1 || rc=$?
  git config -f "$GS_CONFIG" --add sync.root "$dir" || die "cannot write $GS_CONFIG"
  log_msg INFO "watch: $dir"
  echo "Watching: $dir"
  return "$rc"
}

# install_children DIR [ALLOW_EMPTY]: installs every immediate subdirectory of
# DIR that is a git working tree (has a .git dir or file). Not recursive beyond
# depth 1. ALLOW_EMPTY=1: finding no repos is not an error.
install_children() {
  local dir=$1 allow_empty=${2:-0} child repo out found=0 added=0 already=0 failed=0 excluded=0
  [ -d "$dir" ] || die "not a directory: $dir"
  for child in "$dir"/*/; do
    child=${child%/}
    [ -d "$child" ] && [ -e "$child/.git" ] || continue
    found=$((found + 1))
    # Subshell: cmd_install calls die on failure; keep going with the rest.
    # Excluded repos stay out; only `install <repo>` brings one back.
    if repo=$(resolve_repo "$child") && repo_excluded "$repo"; then
      excluded=$((excluded + 1))
      continue
    fi
    if out=$(cmd_install "$child"); then
      echo "$out"
      case "$out" in
        "Already installed:"*) already=$((already + 1)) ;;
        *) added=$((added + 1)) ;;
      esac
    else
      failed=$((failed + 1))
    fi
  done
  [ "$found" -gt 0 ] || [ "$allow_empty" = 1 ] || die "no git repositories found in $dir"
  echo "$added installed, $already already installed, $failed failed, $excluded excluded"
  [ "$failed" -eq 0 ]
}

# watch_scan: install every new repo found directly inside a watched root (same
# child rules as install_children). Runs under the lock, so no duplicates.
watch_scan() {
  local root child repo sf known nl='
'
  # Listed and excluded paths, read once. Both are canonical main-worktree
  # paths, so a child already among them needs no git call at all.
  known="$nl$(list_repos)$nl$(list_excludes)$nl"
  # Warnings never change the exit code or notifications; stderr only in manual runs.
  list_roots | while IFS= read -r root; do
    if ! [ -d "$root" ] || ! [ -r "$root" ] || ! [ -x "$root" ]; then
      log_msg WARN "watched root missing or unreadable: $root"
      [ "$GS_JOB" = 1 ] || warn "watched root missing or unreadable: $root"
      continue
    fi
    for child in "$root"/*/; do
      child=${child%/}
      [ -d "$child" ] && [ -e "$child/.git" ] || continue
      case "$known" in *"$nl$child$nl"*) continue ;; esac
      if ! repo=$(resolve_repo "$child"); then
        log_msg WARN "skipped $child: not a usable repository (watched root $root)"
        continue
      fi
      case "$known" in *"$nl$repo$nl"*) continue ;; esac
      git config -f "$GS_CONFIG" --add sync.repo "$repo" || continue
      known="$known$repo$nl"
      log_msg INFO "installed $repo (watched root $root)"
      # Install time drives the 24h `new` note in status; status_write keeps it.
      sf=$(status_file "$repo")
      mkdir -p "$GS_STATUS_DIR" && rm -f "$sf" &&
        git config -f "$sf" status.path "$repo" &&
        git config -f "$sf" status.watchInstalled "$(now)"
    done
  done
}

# uninstall_root <dir> --watch: stop watching <dir>; its repos and exclusions stay.
uninstall_root() {
  local dir parent
  parse_root_args "usage: git-sync uninstall -r <dir> --watch" "$@"
  [ "$ROOT_WATCH" = 1 ] || usage_die "usage: git-sync uninstall -r <dir> --watch"
  # The root may be gone already: canonicalize its parent instead.
  if ! dir=$(cd -P "$ROOT_DIR" 2>/dev/null && pwd); then
    dir=${ROOT_DIR%/}
    if parent=$(cd -P "$(dirname "$dir")" 2>/dev/null && pwd); then
      dir="$parent/$(basename "$dir")"
    fi
  fi
  root_watched "$dir" || die "not a watched root: $dir"
  git config -f "$GS_CONFIG" --fixed-value --unset-all sync.root "$dir" || die "cannot write $GS_CONFIG"
  log_msg INFO "unwatch: $dir"
  echo "Unwatched: $dir"
}

cmd_uninstall() {
  if [ "${1:-}" = "-r" ]; then
    shift
    uninstall_root "$@"
    return
  fi
  local target=${1:-.} repo parent
  if [ -d "$target" ] && repo=$(resolve_repo "$target"); then
    :
  else
    if parent=$(cd -P "$(dirname "$target")" 2>/dev/null && pwd); then
      repo="$parent/$(basename "$target")"
    else
      repo=$target
    fi
  fi
  repo_listed "$repo" || die "not in sync list: $repo"
  git config -f "$GS_CONFIG" --fixed-value --unset sync.repo "$repo" || die "cannot write $GS_CONFIG"
  git -C "$repo" config --remove-section git-sync 2>/dev/null
  rm -f "$(status_file "$repo")"
  log_msg INFO "uninstall: $repo"
  echo "Uninstalled: $repo"
  # Under a watched root (depth 1): exclude it so the next scan doesn't add it back.
  if root_watched "$(dirname "$repo")" && ! repo_excluded "$repo"; then
    git config -f "$GS_CONFIG" --add sync.exclude "$repo" || die "cannot write $GS_CONFIG"
    log_msg INFO "exclude: $repo"
    echo "Excluded from watched root $(dirname "$repo")"
  fi
}

cmd_list() {
  case "${1:-}" in
    "") ;;
    --watch)
      [ $# -eq 1 ] || usage_die "usage: git-sync list [--watch]"
      list_roots
      return 0 ;;
    *) usage_die "usage: git-sync list [--watch]" ;;
  esac
  list_repo_lines
  list_section "Watched roots:" "$(list_roots)"
  list_section "Excluded:" "$(list_excludes)"
  return 0
}

# list_section HEADER LINES: a blank line, HEADER, then LINES indented; nothing if empty.
list_section() {
  [ -n "$2" ] || return 0
  printf '\n%s\n' "$1"
  printf '%s\n' "$2" | sed 's/^/  /'
}

list_repo_lines() {
  local repo mode result
  if [ -z "$(list_repos)" ]; then
    echo "No repos."
    return 0
  fi
  list_repos | while IFS= read -r repo; do
    if [ -d "$repo" ]; then
      mode=$(cfg_get sync.mode "$repo")
      result=$(status_field "$repo" result)
      [ -n "$result" ] || result=never
    else
      mode=$(cfg_get sync.mode)
      result=missing
    fi
    printf '%s  %s  %s\n' "$repo" "$mode" "$result"
  done
}

cmd_sync() {
  local all=0 repo n=0 ok=0 blocked=0 failed=0 rc=0 keys line entries listed path= runfile result hosts h c w
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=1 ;;
      --job) GS_JOB=1 ;;
      -*) usage_die "sync: unknown argument: $1" ;;
      *)
        [ -z "$path" ] || usage_die "sync: only one <path> allowed"
        path=$1 ;;
    esac
    shift
  done
  [ "$all" = 0 ] || [ -z "$path" ] || usage_die "sync: use either --all or <path>"
  # --all reads its entries after the watch scan, under the lock.
  if [ -n "$path" ]; then
    repo=$(resolve_repo "$path") || die "not a git repository: $path"
    entries=$repo
  elif [ "$all" = 0 ]; then
    repo=$(resolve_repo .) || usage_die "not in a git repository; use 'git-sync sync --all'"
    entries=$repo
  fi
  log_rotate
  if ! lock_acquire; then
    log_msg INFO "another run in progress"
    echo "another run in progress"
    return 0
  fi
  if [ "$all" = 1 ]; then
    watch_scan
    entries=$(list_repos)
  fi
  if [ "$(cfg_get sync.disableOfflineCheck)" != true ] && needs_offline_check "$entries" && ! is_online; then
    log_msg INFO "offline, run skipped"
    streak_record
    [ "$GS_JOB" = 1 ] && return 0
    echo "offline"
    return 1
  fi
  n=$(printf '%s' "$entries" | grep -c .)
  # A run that actually syncs a repo ends any offline streak.
  [ "$n" = 0 ] || streak_clear
  log_msg INFO "run start ($n repos)"
  if [ "$all" = 0 ]; then
    if repo_listed "$repo"; then
      listed=1
    else
      listed=0
      echo "hint: not in sync list; run 'git-sync install $repo' to track it" >&2
    fi
  else
    listed=1
  fi
  # The lock guarantees no other run; leftovers are from a killed run.
  rm -f "$GS_HOME"/run.*
  host_state_clear
  runfile="$GS_HOME/run.$$"
  : > "$runfile" || die "cannot write $runfile"
  if [ "$all" = 1 ]; then
    # Parallel: up to sync.jobs workers, each after a random jitter delay.
    # In the background so that `wait` lets INT/TERM be handled at once.
    sig_defer
    printf '%s\n' "$entries" | grep . | tr '\n' '\0' |
      xargs -0 -n 1 -P "$(cfg_get sync.jobs)" "$(self_path)" __sync-one "$GS_JOB" "$runfile" &
    GS_XARGS_PID=$!
    sig_resume
    wait "$GS_XARGS_PID"
    GS_XARGS_PID=
  else
    sync_one_report "$repo" "$listed" "$runfile"
  fi
  while IFS="$(printf '\t')" read -r result keys line; do
    case "$result" in
      '') continue ;; # empty runfile still yields one blank heredoc line
      ok) ok=$((ok + 1)) ;;
      blocked) blocked=$((blocked + 1)); rc=1 ;;
      *) failed=$((failed + 1)); rc=1 ;;
    esac
    [ "$keys" != - ] || keys=
    notify_collect "$line" "$keys"
  done <<EOF
$(sort -t "$(printf '\t')" -k3 "$runfile")
EOF
  hosts=$(host_report)
  rm -f "$runfile"
  host_state_clear
  # One report per unreachable host that caused host skips.
  while IFS="$(printf '\t')" read -r h c; do
    [ -n "$h" ] || continue
    if [ "$c" = 1 ]; then w=remote; else w=remotes; fi
    log_msg WARN "$h: unreachable, $c $w skipped"
    [ "$GS_JOB" = 1 ] || echo "$h: unreachable, $c $w skipped"
    NOTIFY_HOSTS="$NOTIFY_HOSTS; $h unreachable ($c skipped)"
  done <<EOF
$hosts
EOF
  # A worker that died without reporting counts as failed.
  if [ $((ok + blocked + failed)) -lt "$n" ]; then
    log_msg ERROR "$((n - ok - blocked - failed)) repo(s) did not report a result"
    failed=$((n - ok - blocked)); rc=1
  fi
  log_msg INFO "run end: $ok ok, $blocked blocked, $failed failed"
  if command -v notify_run_end >/dev/null 2>&1; then notify_run_end "$ok" "$blocked" "$failed"; fi
  return "$rc"
}

cmd_config() {
  local global=0 force=0 unset=0 key= val= nargs=0 repo= name target k v src
  while [ $# -gt 0 ]; do
    case "$1" in
      --global) global=1 ;;
      --force) force=1 ;;
      --unset) unset=1 ;;
      -*) usage_die "unknown option: $1" ;;
      *)
        nargs=$((nargs + 1))
        case $nargs in
          1) key=$1 ;;
          2) val=$1 ;;
          *) usage_die "too many arguments" ;;
        esac ;;
    esac
    shift
  done

  if [ "$global" -eq 0 ]; then repo=$(in_repo_root) || repo=; fi

  if [ "$nargs" -eq 0 ]; then
    [ "$unset" -eq 0 ] || usage_die "--unset requires a key"
    for k in sync.period sync.mode sync.branches sync.ffCheckedOut sync.fetchTimeout sync.jobs sync.jitter sync.disableOfflineCheck log.maxSize notify.enabled notify.events; do
      v=$(cfg_get "$k" "$repo")
      src=$(cfg_source "$k" "$repo")
      if [ "$src" = default ] && [ "$k" = sync.branches ]; then
        echo "$k = $v (default: repository default branch)"
      else
        echo "$k = $v ($src)"
      fi
    done
    return 0
  fi

  case "$key" in
    sync.repo|sync.root|sync.exclude)
      if [ "$nargs" -ge 2 ] || [ "$unset" -eq 1 ]; then
        usage_die "$key is managed by 'git-sync install/uninstall'"
      fi
      git config -f "$GS_CONFIG" --get-all "$key"
      return ;;
  esac

  if ! cfg_known "$key" && [ "$force" -eq 0 ]; then
    usage_die "unknown key: $key"
  fi

  if [ "$nargs" -eq 1 ] && [ "$unset" -eq 0 ]; then
    if cfg_known "$key"; then
      cfg_get "$key" "$repo"
    elif [ "$global" -eq 1 ]; then
      git config -f "$GS_CONFIG" --get "$key"
    else
      [ -n "$repo" ] || usage_die "not in a git repository; use --global"
      git -C "$repo" config --get "$key"
    fi
    return $?
  fi

  if [ "$unset" -eq 0 ] && cfg_known "$key"; then
    validate_value "$key" "$val" || exit 2
  fi

  if [ "$global" -eq 1 ]; then
    target=global
    name=$key
  else
    [ -n "$repo" ] || usage_die "not in a git repository; use --global"
    target=repo
    if cfg_known "$key"; then
      name=$(cfg_repo_name "$key") || usage_die "$key is global-only; use --global"
    else
      name=$key
    fi
  fi

  if [ "$unset" -eq 1 ]; then
    if [ "$target" = global ]; then
      git config -f "$GS_CONFIG" --unset "$name"
    else
      git -C "$repo" config --unset "$name"
    fi
    case $? in 0|5) ;; *) die "cannot unset $key" ;; esac
  else
    if [ "$target" = global ]; then
      git config -f "$GS_CONFIG" "$name" "$val" || die "cannot write $key"
    else
      git -C "$repo" config "$name" "$val" || die "cannot write $key"
    fi
  fi

  if [ "$target" = global ] && [ "$key" = sync.period ]; then
    if command -v agent_reload_if_installed >/dev/null 2>&1; then agent_reload_if_installed; fi
  fi
  return 0
}

cmd_start() {
  local period
  agent_write_plist
  : > "$GS_LAUNCHD_LOG"
  $GS_LAUNCHCTL bootout "gui/$(id -u)/$GS_LABEL" >/dev/null 2>&1
  $GS_LAUNCHCTL bootstrap "gui/$(id -u)" "$GS_PLIST" || die "launchctl bootstrap failed"
  period=$(cfg_get sync.period)
  log_msg INFO "agent started (every $period)"
  echo "Started (every $period)"
}

cmd_stop() {
  $GS_LAUNCHCTL bootout "gui/$(id -u)/$GS_LABEL" >/dev/null 2>&1
  rm -f "$GS_PLIST"
  log_msg INFO "agent stopped"
  echo "Stopped"
}

cmd_notifications() {
  case "${1:-}" in
    "") ;;
    enable) git config -f "$GS_CONFIG" notify.enabled true ;;
    disable) git config -f "$GS_CONFIG" notify.enabled false ;;
    *) usage_die "usage: git-sync notifications [enable|disable]" ;;
  esac
  if [ "$(cfg_get notify.enabled)" = true ]; then
    echo "enabled ($(cfg_get notify.events))"
  else
    echo disabled
  fi
}

# status_render VERBOSE LIST_ORDER: the per-repo part of `status`. One awk pass
# reads the repo list and every status file (matched by status.path), so the
# cost does not grow by a process per repo.
#
# Compact: at most two lines per repo — "<result> <time ago> <path>" in aligned
# columns, then blocker keys if any, else notes if any. Verbose: every field.
# Order: blocked, error, missing, then the rest (list order within a group);
# LIST_ORDER=1 keeps plain list order.
status_render() {
  local verbose=$1 list_order=$2 repo i=0 exists mode gmode
  gmode=$(cfg_get sync.mode)
  set --
  for f in "$GS_STATUS_DIR"/*; do [ -f "$f" ] && set -- "$@" "$f"; done
  list_repos | while IFS= read -r repo; do
    i=$((i + 1))
    if [ -d "$repo" ]; then exists=1; else exists=0; fi
    mode=
    # Mode for repos without a status file (verbose only).
    if [ "$verbose" = 1 ] && [ "$exists" = 1 ]; then
      mode=$(git -C "$repo" config --get git-sync.mode 2>/dev/null) || mode=$gmode
    fi
    printf '%s\t%s\t%s\t%s\n' "$i" "$exists" "${mode:-$gmode}" "$repo"
  done | awk -v verbose="$verbose" -v list_order="$list_order" -v now="$(date +%s)" \
             -v home="$HOME" -f /dev/fd/3 - "$@" 3<<'AWK'
# git-config value: drop unescaped quotes, unescape \" \\ \n \t.
function unq(v,   out, i, c) {
  out = ""
  for (i = 1; i <= length(v); i++) {
    c = substr(v, i, 1)
    if (c == "\\" && i < length(v)) {
      i++; c = substr(v, i, 1)
      if (c == "n") c = "\n"; else if (c == "t") c = "\t"
      out = out c; continue
    }
    if (c == "\"") continue
    out = out c
  }
  return out
}
# "2026-10-01T15:33:46+0200" -> epoch seconds, or -1.
function iso2epoch(s,   y, m, d, era, yoe, mp, doy, doe, e, off) {
  if (s !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9][+-][0-9][0-9][0-9][0-9]$/) return -1
  y = substr(s, 1, 4) + 0; m = substr(s, 6, 2) + 0; d = substr(s, 9, 2) + 0
  if (m <= 2) y--
  era = int(y / 400); yoe = y - era * 400
  mp = (m + 9) % 12
  doy = int((153 * mp + 2) / 5) + d - 1
  doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
  e = (era * 146097 + doe - 719468) * 86400 \
      + substr(s, 12, 2) * 3600 + substr(s, 15, 2) * 60 + substr(s, 18, 2)
  off = substr(s, 21, 2) * 3600 + substr(s, 23, 2) * 60
  return substr(s, 20, 1) == "+" ? e - off : e + off
}
function ago(s,   e, secs, n, unit) {
  if (s == "") return "never"
  e = iso2epoch(s)
  if (e < 0) return "unknown"
  secs = now - e
  if (secs < 60) return "< 1m ago"
  if (secs < 3600) { n = int(secs / 60); unit = "minute" }
  else if (secs < 86400) { n = int(secs / 3600); unit = "hour" }
  else { n = int(secs / 86400); unit = "day" }
  return n " " unit (n == 1 ? "" : "s") " ago"
}
FILENAME == "-" {
  split($0, a, "\t")
  n++; idx[n] = a[1]; ex[n] = a[2]; cmode[n] = a[3]
  rp[n] = substr($0, length(a[1]) + length(a[2]) + length(a[3]) + 4)
  next
}
FNR == 1 { p = "" ; delete f }
/^[ \t]*[A-Za-z]+[ \t]*=/ {
  k = $0; sub(/^[ \t]*/, "", k); sub(/[ \t]*=.*/, "", k); k = tolower(k)
  v = $0; sub(/^[^=]*=[ \t]?/, "", v); v = unq(v)
  if (k == "path") p = v
  else f[k] = (k == "blocker" || k == "note") && (k in f) ? f[k] "\001" v : v
}
# Each file ends with its fields collected; store them under its path.
{ if (p != "") for (k in f) S[p, k] = f[k] }
END {
  ind = "                        "
  for (r = 0; r <= 3; r++) {
    for (j = 1; j <= n; j++) {
      repo = rp[j]
      # A watch install writes a status file before the first sync: no result yet.
      res = !ex[j] ? "missing" : ((repo, "result") in S ? S[repo, "result"] : "pending")
      rank = list_order ? 0 : (res == "blocked" ? 0 : res == "error" ? 1 : res == "missing" ? 2 : 3)
      if (rank != r) continue
      shown = repo
      if (index(repo, home "/") == 1) shown = "~" substr(repo, length(home) + 1)
      blk = (repo, "blocker") in S ? S[repo, "blocker"] : ""
      nts = (repo, "note") in S ? S[repo, "note"] : ""
      # `new`: installed by a watch less than 24h ago.
      if ((repo, "watchinstalled") in S) {
        e = iso2epoch(S[repo, "watchinstalled"])
        if (e >= 0 && now - e < 86400) nts = "new" (nts != "" ? "\001" nts : "")
      }
      if (!verbose) {
        printf "%-8s %-14s %s\n", res, ago((repo, "lastrun") in S ? S[repo, "lastrun"] : ""), shown
        if (!ex[j]) continue
        if (blk != "") {
          cnt = split(blk, b, "\001"); line = ""
          for (q = 1; q <= cnt; q++) { sub(/ .*/, "", b[q]); line = line (q > 1 ? ", " : "") b[q] }
          print ind "blocked by: " line
        } else if (nts != "") {
          gsub("\001", "; ", nts); print ind "note: " nts
        }
        continue
      }
      if (printed++) print ""
      print repo
      if (!ex[j]) { print "  result:        missing"; continue }
      print "  mode:          " ((repo, "mode") in S ? S[repo, "mode"] : cmode[j])
      print "  result:        " (res == "pending" ? "never" : res)
      print "  last run:      " ((repo, "lastrun") in S ? S[repo, "lastrun"] : "never")
      print "  last success:  " ((repo, "lastsuccess") in S ? S[repo, "lastsuccess"] : "never")
      if (blk != "") { cnt = split(blk, b, "\001"); for (q = 1; q <= cnt; q++) print "  blocker:       " b[q] }
      if (nts != "") { cnt = split(nts, b, "\001"); for (q = 1; q <= cnt; q++) print "  note:          " b[q] }
    }
  }
}
AWK
}

cmd_status() {
  local verbose=0 list_order=0 since
  while [ $# -gt 0 ]; do
    case "$1" in
      -v|--verbose) verbose=1 ;;
      -l|--list-order) list_order=1 ;;
      *) usage_die "unknown option for status: $1" ;;
    esac
    shift
  done
  if agent_loaded; then echo "Agent:         loaded"; else echo "Agent:         not loaded"; fi
  echo "Period:        $(cfg_get sync.period)"
  if [ "$(cfg_get notify.enabled)" = true ]; then
    echo "Notifications: enabled ($(cfg_get notify.events))"
  else
    echo "Notifications: disabled"
  fi
  since=$(streak_read since) &&
    echo "Offline:       skipped since $since (last $(streak_read lastSkip))"
  if [ -z "$(list_repos)" ]; then
    echo "No repos."
    return 0
  fi
  status_render "$verbose" "$list_order"
}

# ---- dispatch ----
cmd=${1:-help}
case "$cmd" in
  help|-h|--help|init) ;;
  install|uninstall|list|status|start|stop|config|sync|notifications|__sync-one) require_init ;;
esac
case "$cmd" in
  help|-h|--help) cmd_help ;;
  init) cmd_init ;;
  install) shift; cmd_install "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  list) shift; cmd_list "$@" ;;
  status) shift; cmd_status "$@" ;;
  start) shift; cmd_start "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  config) shift; cmd_config "$@" ;;
  sync) shift; cmd_sync "$@" ;;
  __sync-one) shift; cmd___sync_one "$@" ;;
  notifications) shift; cmd_notifications "$@" ;;
  *) usage_die "unknown command: $cmd" ;;
esac
