#!/bin/sh
# git-sync: keep git repos fresh on macOS via launchd.
set -u

# ---- constants ----
GS_HOME=${GIT_SYNC_HOME:-$HOME/.git-sync}
GS_CONFIG="$GS_HOME/config"
GS_STATUS_DIR="$GS_HOME/status"
GS_LOG="$GS_HOME/git-sync.log"
GS_LAUNCHD_LOG="$GS_HOME/launchd.log"
GS_LOCK="$GS_HOME/lock"
GS_AGENTS_DIR=${GIT_SYNC_AGENTS_DIR:-$HOME/Library/LaunchAgents}
GS_LABEL=com.git-sync.agent
GS_PLIST="$GS_AGENTS_DIR/$GS_LABEL.plist"
GS_LAUNCHCTL=${GIT_SYNC_LAUNCHCTL:-launchctl}

# ---- util ----
die() { echo "git-sync: $*" >&2; exit 1; }
usage_die() {
  echo "git-sync: $*" >&2
  echo "Run 'git-sync help' for usage." >&2
  exit 2
}
warn() { echo "git-sync: warning: $*" >&2; }
now() { date +%Y-%m-%dT%H:%M:%S%z; }
require_init() {
  [ -f "$GS_CONFIG" ] || die "not initialized; run 'git-sync init'"
}

# ---- config ----
cfg_known() {
  case "$1" in
    sync.period|sync.repo|sync.mode|sync.branches|sync.ffCheckedOut|log.maxSize|notify.enabled|notify.events) return 0 ;;
  esac
  return 1
}

cfg_default() {
  case "$1" in
    sync.period) echo 20m ;;
    sync.mode) echo fast-forward ;;
    sync.branches) echo "" ;;
    sync.ffCheckedOut) echo false ;;
    log.maxSize) echo 3M ;;
    notify.enabled) echo false ;;
    notify.events) echo blocked ;;
    *) return 1 ;;
  esac
}

cfg_repo_name() {
  case "$1" in
    sync.mode) echo git-sync.mode ;;
    sync.branches) echo git-sync.branches ;;
    sync.ffCheckedOut) echo git-sync.ffCheckedOut ;;
    *) return 1 ;;
  esac
}

cfg_global_get() {
  git config -f "$GS_CONFIG" --get "$1" 2>/dev/null
}

cfg_get() {
  local key=$1 repo=${2:-} name val
  if [ -n "$repo" ] && name=$(cfg_repo_name "$key"); then
    if val=$(git -C "$repo" config --get "$name" 2>/dev/null); then
      printf '%s\n' "$val"
      return 0
    fi
  fi
  if val=$(cfg_global_get "$key"); then
    printf '%s\n' "$val"
    return 0
  fi
  cfg_default "$key"
}

cfg_source() {
  local key=$1 repo=${2:-} name
  if [ -n "$repo" ] && name=$(cfg_repo_name "$key") &&
     git -C "$repo" config --get "$name" >/dev/null 2>&1; then
    echo repo
  elif cfg_global_get "$key" >/dev/null; then
    echo global
  else
    echo default
  fi
}

parse_period() {
  local v=$1 n
  case "$v" in
    *s) echo "${v%s}" ;;
    *m) n=${v%m}; echo $((n * 60)) ;;
    *h) n=${v%h}; echo $((n * 3600)) ;;
    *) echo "$v" ;;
  esac
}

parse_size() {
  local v=$1 n
  case "$v" in
    *K) n=${v%K}; echo $((n * 1024)) ;;
    *M) n=${v%M}; echo $((n * 1048576)) ;;
    *G) n=${v%G}; echo $((n * 1073741824)) ;;
    *) echo "$v" ;;
  esac
}

validate_value() {
  local key=$1 v=$2 w
  case "$key" in
    sync.period)
      if ! printf '%s' "$v" | grep -Eq '^[1-9][0-9]*[smh]?$'; then
        echo "git-sync: sync.period must look like 20m, 90, 2h or 45s" >&2; return 1
      fi
      if [ "$(parse_period "$v")" -lt 60 ]; then
        echo "git-sync: sync.period must be >= 60s" >&2; return 1
      fi ;;
    sync.mode)
      case "$v" in
        maintain-only|maintain-and-fetch|fast-forward) ;;
        *) echo "git-sync: sync.mode must be one of: maintain-only, maintain-and-fetch, fast-forward" >&2; return 1 ;;
      esac ;;
    sync.branches)
      if [ -z "$v" ]; then
        echo "git-sync: sync.branches must not be empty (unset it instead)" >&2; return 1
      fi
      for w in $v; do
        if ! git check-ref-format --branch "$w" >/dev/null 2>&1; then
          echo "git-sync: invalid branch name: $w" >&2; return 1
        fi
      done ;;
    sync.ffCheckedOut|notify.enabled)
      case "$v" in
        true|false) ;;
        *) echo "git-sync: $key must be true or false" >&2; return 1 ;;
      esac ;;
    log.maxSize)
      if ! printf '%s' "$v" | grep -Eq '^[1-9][0-9]*[KMG]?$'; then
        echo "git-sync: log.maxSize must look like 3M, 512K, 1G or a byte count" >&2; return 1
      fi ;;
    notify.events)
      if [ -z "$v" ]; then
        echo "git-sync: notify.events must not be empty" >&2; return 1
      fi
      for w in $v; do
        case "$w" in
          start|finished|blocked) ;;
          *) echo "git-sync: invalid notify event: $w (allowed: start finished blocked)" >&2; return 1 ;;
        esac
      done ;;
  esac
  return 0
}

in_repo_root() {
  resolve_repo .
}

# ---- repos ----
# Prints the canonical main-worktree path of the repo containing PATH; rc 1 if none.
resolve_repo() {
  (
    cd "$1" 2>/dev/null || exit 1
    common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 1
    case "$common" in
      */.git) top=$(dirname "$common") ;;
      *) top=$common ;;
    esac
    cd -P "$top" 2>/dev/null && pwd
  )
}

is_linked_worktree() {
  local gd cd_
  gd=$(git -C "$1" rev-parse --path-format=absolute --git-dir 2>/dev/null) || return 1
  cd_=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [ "$gd" != "$cd_" ]
}

list_repos() {
  git config -f "$GS_CONFIG" --get-all sync.repo 2>/dev/null
}

repo_listed() {
  list_repos | grep -Fxq -- "$1"
}

# ---- log/lock/status ----
status_file() {
  local id
  id=$(printf %s "$1" | shasum -a 1 | cut -c1-16)
  printf '%s/%s\n' "$GS_STATUS_DIR" "$id"
}

status_field() {
  git config -f "$(status_file "$1")" "status.$2" 2>/dev/null
}

# Appends a log line; never fails the caller.
log_msg() {
  mkdir -p "$GS_HOME" 2>/dev/null
  printf '%s %s %s\n' "$(now)" "$1" "$2" >> "$GS_LOG" 2>/dev/null
  return 0
}

# ---- sync engine ----

# ---- agent ----

# ---- notifications ----

# ---- commands ----
cmd_help() {
  cat <<'EOF'
Usage: git-sync <command> [args]

Commands:
  init                         Create ~/.git-sync with default config
  install [<path>]             Add a repo (default: current) to the sync list
  uninstall [<path>]           Remove a repo from the sync list
  list                         List synced repos
  status                       Show agent state and per-repo sync status
  start                        Install and load the launchd agent
  stop                         Unload and remove the launchd agent
  config [--global] [--force] [--unset] [<key> [<value>]]
                               Show or change configuration
  sync [--all]                 Sync the current repo, or all listed repos
  notifications [enable|disable]
                               Show or toggle notifications
  help                         Show this help
EOF
}

cmd_init() {
  if [ -f "$GS_CONFIG" ]; then
    mkdir -p "$GS_STATUS_DIR" || die "cannot create $GS_STATUS_DIR"
    echo "git-sync: already initialized ($GS_HOME)"
    return 0
  fi
  mkdir -p "$GS_STATUS_DIR" || die "cannot create $GS_STATUS_DIR"
  git config -f "$GS_CONFIG" sync.period 20m &&
  git config -f "$GS_CONFIG" sync.mode fast-forward &&
  git config -f "$GS_CONFIG" sync.ffCheckedOut false &&
  git config -f "$GS_CONFIG" log.maxSize 3M &&
  git config -f "$GS_CONFIG" notify.enabled false &&
  git config -f "$GS_CONFIG" notify.events blocked ||
    die "cannot write $GS_CONFIG"
  echo "Initialized git-sync in $GS_HOME"
  echo "Next: run 'git-sync install' inside a repo, then 'git-sync start'."
}

cmd_install() {
  local target=${1:-.} repo
  repo=$(resolve_repo "$target") || die "not a git repository: $target"
  if is_linked_worktree "$target"; then
    warn "linked worktree; registered main worktree $repo instead"
    log_msg WARN "install: $target is a linked worktree; registered $repo"
  fi
  if repo_listed "$repo"; then
    echo "Already installed: $repo"
    return 0
  fi
  git config -f "$GS_CONFIG" --add sync.repo "$repo" || die "cannot write $GS_CONFIG"
  log_msg INFO "install: $repo"
  if git -C "$repo" remote | grep -qx origin &&
     ! git -C "$repo" symbolic-ref -q refs/remotes/origin/HEAD >/dev/null; then
    GIT_TERMINAL_PROMPT=0 git -C "$repo" remote set-head origin --auto >/dev/null 2>&1 ||
      warn "could not determine origin/HEAD for $repo"
  fi
  echo "Installed: $repo"
}

cmd_uninstall() {
  local target=${1:-.} repo parent
  if [ -d "$target" ] && repo=$(resolve_repo "$target"); then
    :
  else
    if parent=$(cd -P "$(dirname "$target")" 2>/dev/null && pwd); then
      repo="$parent/$(basename "$target")"
    else
      repo=$target
    fi
  fi
  repo_listed "$repo" || die "not in sync list: $repo"
  git config -f "$GS_CONFIG" --fixed-value --unset sync.repo "$repo" || die "cannot write $GS_CONFIG"
  git -C "$repo" config --remove-section git-sync 2>/dev/null
  rm -f "$(status_file "$repo")"
  log_msg INFO "uninstall: $repo"
  echo "Uninstalled: $repo"
}

cmd_list() {
  local repo mode result
  if [ -z "$(list_repos)" ]; then
    echo "No repos."
    return 0
  fi
  list_repos | while IFS= read -r repo; do
    if [ -d "$repo" ]; then
      mode=$(cfg_get sync.mode "$repo")
      result=$(status_field "$repo" result)
      [ -n "$result" ] || result=never
    else
      mode=$(cfg_get sync.mode)
      result=missing
    fi
    printf '%s  %s  %s\n' "$repo" "$mode" "$result"
  done
}

cmd_config() {
  local global=0 force=0 unset=0 key= val= nargs=0 repo= name target k v src
  while [ $# -gt 0 ]; do
    case "$1" in
      --global) global=1 ;;
      --force) force=1 ;;
      --unset) unset=1 ;;
      -*) usage_die "unknown option: $1" ;;
      *)
        nargs=$((nargs + 1))
        case $nargs in
          1) key=$1 ;;
          2) val=$1 ;;
          *) usage_die "too many arguments" ;;
        esac ;;
    esac
    shift
  done

  if [ "$global" -eq 0 ]; then repo=$(in_repo_root) || repo=; fi

  if [ "$nargs" -eq 0 ]; then
    [ "$unset" -eq 0 ] || usage_die "--unset requires a key"
    for k in sync.period sync.mode sync.branches sync.ffCheckedOut log.maxSize notify.enabled notify.events; do
      v=$(cfg_get "$k" "$repo")
      src=$(cfg_source "$k" "$repo")
      if [ "$src" = default ] && [ "$k" = sync.branches ]; then
        echo "$k = $v (default: repository default branch)"
      else
        echo "$k = $v ($src)"
      fi
    done
    return 0
  fi

  if [ "$key" = sync.repo ]; then
    if [ "$nargs" -ge 2 ] || [ "$unset" -eq 1 ]; then
      usage_die "sync.repo is managed by 'git-sync install/uninstall'"
    fi
    git config -f "$GS_CONFIG" --get-all sync.repo
    return 0
  fi

  if ! cfg_known "$key" && [ "$force" -eq 0 ]; then
    usage_die "unknown key: $key"
  fi

  if [ "$nargs" -eq 1 ] && [ "$unset" -eq 0 ]; then
    if cfg_known "$key"; then
      cfg_get "$key" "$repo"
    elif [ "$global" -eq 1 ]; then
      git config -f "$GS_CONFIG" --get "$key"
    else
      [ -n "$repo" ] || usage_die "not in a git repository; use --global"
      git -C "$repo" config --get "$key"
    fi
    return $?
  fi

  if [ "$unset" -eq 0 ] && cfg_known "$key"; then
    validate_value "$key" "$val" || exit 2
  fi

  if [ "$global" -eq 1 ]; then
    target=global
    name=$key
  else
    [ -n "$repo" ] || usage_die "not in a git repository; use --global"
    target=repo
    if cfg_known "$key"; then
      name=$(cfg_repo_name "$key") || usage_die "$key is global-only; use --global"
    else
      name=$key
    fi
  fi

  if [ "$unset" -eq 1 ]; then
    if [ "$target" = global ]; then
      git config -f "$GS_CONFIG" --unset "$name"
    else
      git -C "$repo" config --unset "$name"
    fi
    case $? in 0|5) ;; *) die "cannot unset $key" ;; esac
  else
    if [ "$target" = global ]; then
      git config -f "$GS_CONFIG" "$name" "$val" || die "cannot write $key"
    else
      git -C "$repo" config "$name" "$val" || die "cannot write $key"
    fi
  fi

  if [ "$target" = global ] && [ "$key" = sync.period ]; then
    if command -v agent_reload_if_installed >/dev/null 2>&1; then agent_reload_if_installed; fi
  fi
  return 0
}

# ---- dispatch ----
cmd=${1:-help}
case "$cmd" in
  help|-h|--help|init) ;;
  install|uninstall|list|status|start|stop|config|sync|notifications) require_init ;;
esac
case "$cmd" in
  help|-h|--help) cmd_help ;;
  init) cmd_init ;;
  install) shift; cmd_install "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  list) shift; cmd_list "$@" ;;
  config) shift; cmd_config "$@" ;;
  *) usage_die "unknown command: $cmd" ;;
esac
